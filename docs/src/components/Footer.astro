---
const base = import.meta.env.BASE_URL;
---

<footer class="ug-footer">
  <div class="ug-footer__inner">
    <a class="ug-footer__brand" href={`${base}`}>Unigrid.css</a>
    <nav>
      <ul class="ug-footer__nav">
        <li><a class="ug-footer__link" href={`${base}docs/getting-started`}>Documentation</a></li>
        <li><a class="ug-footer__link" href={`${base}docs/components/header`}>Components</a></li>
        <li><a class="ug-footer__link" href="https://github.com/tdascoli/unigrid.css"><i class="ug-icon-github ug-icon--sm ug-icon--white"></i></a></li>
        <li><a class="ug-footer__link" href="https://www.npmjs.com/package/unigrid.css"><i class="ug-icon-npm ug-icon--sm ug-icon--white"></i></a></li>
      </ul>
    </nav>
    <hr class="ug-footer__divider">
    <p class="ug-footer__text">Inspired by Massimo Vignelli's Unigrid system for the National Park Service.</p>
    <p class="ug-footer__text">MIT License.</p>
  </div>
</footer>

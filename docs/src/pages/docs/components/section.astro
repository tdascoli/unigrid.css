---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeExample from '../../../components/CodeExample.astro';
import PropsTable from '../../../components/PropsTable.astro';
---

<DocsLayout title="Section" activeNav="Section">

<h1>Section</h1>
<p class="ug-lead">Content sections with consistent vertical spacing, titles, subtitles, and color variants aligned to the vertical rhythm.</p>

<h2>Default Section</h2>

<CodeExample title="Default section">
<Fragment set:html={`<section class="ug-section">
  <h2 class="ug-section__title">Section Title</h2>
  <p class="ug-section__subtitle">A brief description of this section and its purpose.</p>
  <p>Section body content goes here. The section provides consistent vertical padding and spacing for page layout.</p>
</section>`} />
</CodeExample>

<h2>Compact Section</h2>

<CodeExample title="Compact variant">
<Fragment set:html={`<section class="ug-section ug-section--compact">
  <h2 class="ug-section__title">Compact Section</h2>
  <p class="ug-section__subtitle">Reduced padding for tighter layouts.</p>
  <p>This section uses less vertical space while maintaining rhythm alignment.</p>
</section>`} />
</CodeExample>

<h2>Large Section</h2>

<CodeExample title="Large variant">
<Fragment set:html={`<section class="ug-section ug-section--large">
  <h2 class="ug-section__title">Large Section</h2>
  <p class="ug-section__subtitle">Extra vertical padding for prominent sections.</p>
  <p>Use the large variant for hero-like content areas or to create visual breathing room.</p>
</section>`} />
</CodeExample>

<h2>Color Variants</h2>

<CodeExample title="Brown section">
<Fragment set:html={`<section class="ug-section ug-section--brown">
  <h2 class="ug-section__title" style="color:#fff">Brown Section</h2>
  <p style="color:#fff">NPS brown background for branded sections.</p>
</section>`} />
</CodeExample>

<CodeExample title="Green section">
<Fragment set:html={`<section class="ug-section ug-section--green">
  <h2 class="ug-section__title" style="color:#fff">Green Section</h2>
  <p style="color:#fff">NPS green background for nature-themed content.</p>
</section>`} />
</CodeExample>

<CodeExample title="Blue section">
<Fragment set:html={`<section class="ug-section ug-section--blue">
  <h2 class="ug-section__title" style="color:#fff">Blue Section</h2>
  <p style="color:#fff">NPS blue background for informational sections.</p>
</section>`} />
</CodeExample>

<CodeExample title="Red section">
<Fragment set:html={`<section class="ug-section ug-section--red">
  <h2 class="ug-section__title" style="color:#fff">Red Section</h2>
  <p style="color:#fff">NPS red background for alert or highlight sections.</p>
</section>`} />
</CodeExample>

<CodeExample title="Light section">
<Fragment set:html={`<section class="ug-section ug-section--light">
  <h2 class="ug-section__title">Light Section</h2>
  <p>Light background for subtle contrast against a white page.</p>
</section>`} />
</CodeExample>

<h2>Class Reference</h2>

<PropsTable items={[
  { class: '.ug-section', description: 'Section container with vertical padding' },
  { class: '.ug-section__title', description: 'Section heading' },
  { class: '.ug-section__subtitle', description: 'Section subtitle/description' },
  { class: '.ug-section--compact', description: 'Reduced vertical padding' },
  { class: '.ug-section--large', description: 'Increased vertical padding' },
  { class: '.ug-section--brown', description: 'NPS brown background' },
  { class: '.ug-section--red', description: 'NPS red background' },
  { class: '.ug-section--green', description: 'NPS green background' },
  { class: '.ug-section--blue', description: 'NPS blue background' },
  { class: '.ug-section--light', description: 'Light gray background' },
]} />

</DocsLayout>

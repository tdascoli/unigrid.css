  { class: '.ug-icon--green', description: 'Fill: $ug-green' },
  { class: '.ug-icon--blue', description: 'Fill: $ug-blue' },
  { class: '.ug-icon--dark-gray', description: 'Fill: $ug-dark-gray' },
  { class: '.ug-icon--medium-gray', description: 'Fill: $ug-medium-gray' },
  { class: '.ug-icon--light-gray', description: 'Fill: $ug-light-gray' },
  { class: '.ug-icon--current', description: 'Fill: currentColor (default)' },
]} />

</DocsLayout>

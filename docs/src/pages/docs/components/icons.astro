  { class: '.ug-icon--md', description: 'Size: 1 × leading (default)' },
  { class: '.ug-icon--lg', description: 'Size: 1.5 × leading' },
  { class: '.ug-icon--xl', description: 'Size: 2 × leading' },
  { class: '.ug-icon--2xl', description: 'Size: 3 × leading' },
  { class: '.ug-icon--black', description: 'Fill: $ug-black' },
  { class: '.ug-icon--white', description: 'Fill: $ug-white' },
  { class: '.ug-icon--red', description: 'Fill: $ug-red' },

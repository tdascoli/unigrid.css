  { class: '.ug-format', description: 'Base format container (centered, full width)' },
  { class: '.ug-format--a1', description: 'A-series, 1 panel wide, 1 column' },
  { class: '.ug-format--a2', description: 'A-series, 1 panel wide, 2 columns' },
  { class: '.ug-format--a3', description: 'A-series, 1 panel wide, 3 columns' },
  { class: '.ug-format--a4', description: 'A-series, 1 panel wide, 4 columns' },
  { class: '.ug-format--a6', description: 'A-series, 1 panel wide, 6 columns' },
  { class: '.ug-format--b1', description: 'B-series, 2 panels wide, 1 column' },
  { class: '.ug-format--b2', description: 'B-series, 2 panels wide, 2 columns' },
  { class: '.ug-format--b3', description: 'B-series, 2 panels wide, 3 columns' },
  { class: '.ug-format--b4', description: 'B-series, 2 panels wide, 4 columns' },
  { class: '.ug-format--b6', description: 'B-series, 2 panels wide, 6 columns' },
  { class: '.ug-ratio--din', description: 'DIN portrait aspect ratio (1:1.414)' },

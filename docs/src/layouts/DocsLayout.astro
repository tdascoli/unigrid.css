---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description, activeNav } = Astro.props;
const base = import.meta.env.BASE_URL;

const nav = [
  { heading: 'Getting Started', items: [
    { label: 'Introduction', href: `${base}docs/getting-started` },
  ]},
  { heading: 'Layout', items: [
    { label: 'Grid', href: `${base}docs/grid` },
    { label: 'Container', href: `${base}docs/container` },
    { label: 'Breakpoints', href: `${base}docs/breakpoints` },
    { label: 'Formats', href: `${base}docs/formats` },
    { label: 'Modules', href: `${base}docs/modules` },
  ]},
  { heading: 'Typography', items: [
    { label: 'Typography', href: `${base}docs/typography` },
    { label: 'Prose', href: `${base}docs/prose` },
  ]},
  { heading: 'Components', items: [
    { label: 'Header', href: `${base}docs/components/header` },
    { label: 'Navbar', href: `${base}docs/components/navbar` },
    { label: 'Footer', href: `${base}docs/components/footer` },
    { label: 'Hero', href: `${base}docs/components/hero` },
    { label: 'Section', href: `${base}docs/components/section` },
    { label: 'Buttons', href: `${base}docs/components/buttons` },
    { label: 'Cards', href: `${base}docs/components/cards` },
    { label: 'Tables', href: `${base}docs/components/tables` },
    { label: 'List', href: `${base}docs/components/list` },
    { label: 'Forms', href: `${base}docs/components/forms` },
    { label: 'Dropdown', href: `${base}docs/components/dropdown` },
    { label: 'Tabs', href: `${base}docs/components/tabs` },
    { label: 'Accordion', href: `${base}docs/components/accordion` },
    { label: 'Pagination', href: `${base}docs/components/pagination` },
    { label: 'Sidebar', href: `${base}docs/components/sidebar` },
    { label: 'Modal', href: `${base}docs/components/modal` },
    { label: 'Scrollspy', href: `${base}docs/components/scrollspy` },
    { label: 'Divider', href: `${base}docs/components/divider` },
    { label: 'Infobox', href: `${base}docs/components/infobox` },
    { label: 'Icons', href: `${base}docs/components/icons` },
  ]},
  { heading: 'Utilities', items: [
    { label: 'Spacing', href: `${base}docs/utilities/spacing` },
    { label: 'Colors', href: `${base}docs/utilities/colors` },
    { label: 'Visibility', href: `${base}docs/utilities/visibility` },
  ]},
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Unigrid.css</title>
  <meta name="description" content={description || 'CSS framework inspired by Vignelli\'s Unigrid system'}>
  <link rel="icon" href={`${base}unigrid.svg`} sizes="any" type="image/svg+xml">
</head>
<body>

  <header class="ug-header">
    <div class="ug-header__title">
      <a href={`${base}`}>Unigrid</a>
      <p class="ug-header__subtitle">CSS Framework</p>
    </div>
    <nav class="ug-navbar">
      <div class="ug-navbar__inner">
        <button class="ug-navbar__toggle" onclick="var m=this.parentElement.querySelector('.ug-navbar__menu');m.classList.toggle('ug-navbar__menu--open');this.classList.toggle('ug-navbar__toggle--active')">
          <span class="ug-navbar__toggle__label">Menu</span>
          <span class="ug-navbar__toggle__close">Close</span>
        </button>
        <ul class="ug-navbar__menu">
          <li class="ug-navbar__item"><a class="ug-navbar__link" href={`${base}docs/getting-started`}>Docs</a></li>
          <li class="ug-navbar__item"><a class="ug-navbar__link" href={`${base}docs/components/header`}>Components</a></li>
          <li class="ug-navbar__item"><a class="ug-navbar__link" href={`${base}configurator/`}>Configurator</a></li>
          <li class="ug-navbar__item"><a class="ug-navbar__link" href="https://github.com/tdascoli/unigrid.css">GitHub</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <div class="ug-sidebar-layout ug-sidebar-layout--bordered ug-sidebar-layout--sticky">
    <aside class="ug-sidebar-layout__sidebar" id="docs-sidebar">
      <nav style="padding-top: var(--ug-leading)">
        {nav.map(section => (
          <div class="docs-sidebar__section">
            <p class="docs-sidebar__heading">{section.heading}</p>
            {section.items.map(item => (
              <a class={`docs-sidebar__link ${activeNav === item.label ? 'docs-sidebar__link--active' : ''}`}
                 href={item.href}
                 id={activeNav === item.label ? 'docs-sidebar-active' : undefined}>{item.label}</a>
            ))}
          </div>
        ))}
      </nav>
    </aside>
    <main class="ug-sidebar-layout__main" style="display:flex;gap:var(--ug-leading)">
      <div class="ug-container ug-pt--5 ug-pb--5" style="flex:1;min-width:0" id="docs-content">
        <slot />
      </div>
      <aside class="docs-toc" id="docs-toc">
        <nav class="ug-scrollspy" data-ug-scrollspy>
          <p class="docs-sidebar__heading">On this page</p>
          <div class="ug-scrollspy__nav" id="docs-toc-nav"></div>
        </nav>
      </aside>
    </main>
  </div>

  <script is:inline>
    // Scroll sidebar to active item
    (function() {
      var active = document.getElementById('docs-sidebar-active');
      var sidebar = document.getElementById('docs-sidebar');
      if (active && sidebar) {
        sidebar.scrollTop = active.offsetTop - sidebar.offsetTop;
      }
    })();

    // Auto-generate table of contents from h2 headings
    (function() {
      function buildToc() {
        var content = document.getElementById('docs-content');
        var tocNav = document.getElementById('docs-toc-nav');
        if (!content || !tocNav) return;

        var headings = content.querySelectorAll('h2');
        if (headings.length < 2) {
          document.getElementById('docs-toc').style.display = 'none';
          return;
        }

        headings.forEach(function(h, i) {
          if (!h.id) h.id = 'section-' + i;
          var a = document.createElement('a');
          a.className = 'ug-scrollspy__link';
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          tocNav.appendChild(a);
        });

        // Init scrollspy on the generated nav
        initScrollspy();
      }

      function initScrollspy() {
        document.querySelectorAll('[data-ug-scrollspy]').forEach(function(nav) {
          var links = nav.querySelectorAll('.ug-scrollspy__link');
          if (!links.length) return;

          var targets = [];
          links.forEach(function(link) {
            var href = link.getAttribute('href');
            if (!href || href.charAt(0) !== '#') return;
            var target = document.querySelector(href);
            if (target) targets.push({ link: link, target: target });
          });
          if (!targets.length) return;

          var visibleSections = new Set();
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) visibleSections.add(entry.target.id);
              else visibleSections.delete(entry.target.id);
            });
            var activeId = null;
            for (var i = 0; i < targets.length; i++) {
              if (visibleSections.has(targets[i].target.id)) { activeId = targets[i].target.id; break; }
            }
            targets.forEach(function(item) {
              item.link.classList.toggle('ug-scrollspy__link--active', item.target.id === activeId);
            });
          }, { rootMargin: '-100px 0px -50% 0px', threshold: 0 });

          targets.forEach(function(item) { observer.observe(item.target); });
        });
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildToc);
      else buildToc();
    })();
  </script>

  <Footer />

  <script is:inline src={`${base}unigrid.min.js`}></script>

</body>
</html>

<style lang="scss" is:global>
  @use "../styles/docs.scss";
</style>

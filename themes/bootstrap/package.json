{
  "name": "unigrid-bootstrap-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Unigrid-inspired theme for Bootstrap 5",
  "scripts": {
    "build": "sass ../../src/scss/bootstrap/unigrid-bootstrap.scss dist/unigrid-bootstrap.css --style=expanded --load-path=node_modules && sass ../../src/scss/bootstrap/unigrid-bootstrap.scss dist/unigrid-bootstrap.min.css --style=compressed --load-path=node_modules",
    "watch": "sass ../../src/scss/bootstrap/unigrid-bootstrap.scss dist/unigrid-bootstrap.css --style=expanded --watch --load-path=node_modules",
    "dev": "npx serve ."
  },
  "devDependencies": {
    "bootstrap": "^5.3.0",
    "sass": "^1.80.0",
    "serve": "^14.0.0"
  }
}
